{
  "log": { "level": "error" },
  "dns": {
    "servers": [{ "type": "hosts", "tag": "test-hosts", "predefined": {
      "chatgpt.com": "127.0.0.1", "persistent.oaistatic.com": "127.0.0.1",
      "keyword.example": "127.0.0.1", "regex.example": "127.0.0.1",
      "cidr.example": "127.0.0.1", "default.example": "127.0.0.1",
      "failed.example": "127.0.0.1"
    }}], "final": "test-hosts"
  },
  "inbounds": [{ "type": "mixed", "tag": "test-in", "listen": "127.0.0.1", "listen_port": 19080 }],
  "outbounds": [
    { "type": "direct", "tag": "VPN-out" },
    { "type": "direct", "tag": "fallback-out" }
  ],
  "route": {
    "default_domain_resolver": "test-hosts",
    "rules": [
      { "type": "logical", "mode": "and", "rules": [
        { "inbound": ["test-in"], "domain_suffix": ["dell.com", "2ip.io", "vencord.dev", "chatgpt.com", "oaistatic.com"] },
        { "source_ip_cidr": ["127.0.0.2"], "invert": true }
      ], "outbound": "VPN-out" },
      { "type": "logical", "mode": "and", "rules": [
        { "domain_suffix": ["failed.example"] },
        { "source_ip_cidr": ["127.0.0.2"] }
      ], "outbound": "VPN-out" },
      { "domain_keyword": ["keyword"], "outbound": "VPN-out" },
      { "domain_regex": ["^regex\\.example$"], "outbound": "VPN-out" },
      { "domain": ["cidr.example"], "action": "resolve", "server": "test-hosts" },
      { "ip_cidr": ["10.0.0.0/8", "192.0.2.0/24", "2001:db8::/32", "127.0.0.1"], "outbound": "VPN-out" }
    ], "final": "fallback-out"
  },
  "experimental": { "clash_api": { "external_controller": "127.0.0.1:19090" } }
}
